**/target/
**/.idea/
*.db
**/.DS_Store
**/book/

# Compiled assembly output — archive/asm_examples/ should only ever track
# source (.s), linker scripts (.ld), companion scripts (.py), and docs.
*.o
*.elf
*.out
archive/asm_examples/**/*
!archive/asm_examples/**/*.s
!archive/asm_examples/**/*.ld
!archive/asm_examples/**/*.py
!archive/asm_examples/**/*.md
!archive/asm_examples/*/
